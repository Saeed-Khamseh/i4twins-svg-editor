{
  "name": "svg-editor",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:api": "tsx server/index.ts",
    "start:app": "ng serve --proxy-config proxy.conf.json",
    "start": "concurrently \"npm run start:api\" \"npm run start:app\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
